{
  "realm": "services",
  "enabled": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "myid.use",
        "description": "calls the MyID adapter (myid-adapter-api)"
      },
      {
        "name": "sms.use",
        "description": "calls the SMS adapter (sms-adapter-api)"
      },
      {
        "name": "taf.use",
        "description": "calls the TAF adapter (taf-adapter-api)"
      },
      {
        "name": "push.use",
        "description": "calls the push adapter (push-adapter-api)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "customer-gateway",
      "name": "customer gateway, calling the MyID, SMS and TAF adapters",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience myid-adapter",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "myid-adapter",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "audience sms-adapter",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "sms-adapter",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "audience taf-adapter",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "taf-adapter",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "workers",
      "name": "workers (lost code, push messages), calling the MyID and push adapters",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience myid-adapter",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "myid-adapter",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "audience push-adapter",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "push-adapter",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-customer-gateway",
      "enabled": true,
      "serviceAccountClientId": "customer-gateway",
      "realmRoles": [
        "myid.use",
        "sms.use",
        "taf.use"
      ]
    },
    {
      "username": "service-account-workers",
      "enabled": true,
      "serviceAccountClientId": "workers",
      "realmRoles": [
        "myid.use",
        "push.use"
      ]
    }
  ]
}
