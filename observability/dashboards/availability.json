    {
      "type": "timeseries",
      "title": "Calls to MyID per minute, by outcome",
      "description": "myid-adapter's calls to MyID, by outcome (SUCCESS, CLIENT_ERROR, SERVER_ERROR, UNKNOWN for no answer).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(http_client_requests_milliseconds_count{service_name=\"myid-adapter\"}[5m])) * 60",
          "legendFormat": "{{{{service_name}}}} {{{{outcome}}}}",
          "refId": "A"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "MyID answer time p95",
      "description": "95% of MyID's answers come within this time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_client_requests_milliseconds_bucket{service_name=\"myid-adapter\"}[5m])))",
          "legendFormat": "{{{{service_name}}}}",
          "refId": "A"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Requests per minute into the MyID adapter, by status",
      "description": "What heeyID's services asked the MyID adapter, health checks left out",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(http_server_requests_milliseconds_count{service_name=\"myid-adapter\",uri!~\"/actuator.*\"}[5m])) * 60",
          "legendFormat": "{{service_name}} {{status}}",
          "refId": "A"
        }
      ],
      "id": 8
    },
    {
      "type": "table",
      "title": "Health components DOWN",
      "description": "Each component a service checks (its database, an adapter, disk space...) that reports DOWN now. Empty: all UP.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "last_over_time(platform_health_up[2m]) == 0",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "id": 9
    },
    {
      "type": "logs",
      "title": "Warnings and errors (each line links to its trace)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"myid-adapter|sms-adapter|taf-adapter|push-adapter\"} | detected_level=~\"warn|error\"",
          "refId": "A"
        }
      ],
      "id": 10
    }
  ]
}
